// Pylota Mail landing page and docs, deployed as an assets-only Worker:
// no Worker script ("main") and no bindings.
//
// Build the docs first (`mdbook build docs` writes them to site/public/docs), then:
//   npx --yes wrangler@4.139.0 deploy --config site/wrangler.jsonc
{
  "name": "pylota-mail-site",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },

  // Production hostnames. A Custom Domain makes Cloudflare create the DNS record
  // and certificate on deploy. pylotamail.com is also the shared mail domain of
  // Pylota Mail Cloud: its MX, SPF and DKIM records are separate DNS records and are
  // not touched by this. Self-hosters: replace these with your own hostnames (the
  // zone must be on Cloudflare in the same account), or delete the block to serve
  // the site on workers.dev only.
  "routes": [
    { "pattern": "pylotamail.com", "custom_domain": true },
    { "pattern": "www.pylotamail.com", "custom_domain": true }
  ]
}
